# ==============================================================================
# EnergySense - ThingSpeak Configuration & Settings
# ==============================================================================
# Enter your ThingSpeak Channel ID and READ API Key below.
# NEVER put your WRITE API Key here.

THINGSPEAK_CHANNEL_ID=YOUR_CHANNEL_ID
THINGSPEAK_READ_API_KEY=YOUR_READ_API_KEY

# Data Freshness Timeout (in seconds)
# If no new feeds arrive within this duration, ESP32 is marked OFFLINE.
DATA_TIMEOUT=60

# Dashboard Polling Interval (in seconds)
REFRESH_INTERVAL=15

# Electricity Tariff in INR (₹ per kWh)
ELECTRICITY_TARIFF=7.50
